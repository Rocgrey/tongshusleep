<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>SleepAPIBaseURL</key><string>$(SLEEP_API_BASE_URL)</string>
    <key>SleepGatewayShareCode</key><string>$(SLEEP_GATEWAY_SHARE_CODE)</string>
    <key>UIBackgroundModes</key><array><string>audio</string></array>
    <key>SleepHealthKitEnabled</key><string>$(SLEEP_HEALTHKIT_ENABLED)</string>
    <key>NSMicrophoneUsageDescription</key><string>手机监测在本机分析夜间声音，估算疑似鼾声和说话声，不保存原始录音。</string>
    <key>NSMotionUsageDescription</key><string>手机监测使用加速度传感器观察床面体动，辅助估算安静时段。</string>
    <key>NSHealthShareUsageDescription</key><string>读取你允许的睡眠时间与阶段，在本机展示睡眠图表和来源；不会自动上传或写回系统健康。健康概览还可读取你允许的心率、HRV、血氧、呼吸、步数、距离、能量、身体测量、体能训练、血压、最大摄氧量及年龄参考资料。你可选择允许读取的项目。</string>
</dict></plist>
