<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>SleepGrove</string>
    <key>SleepPushEnabled</key><string>$(SLEEP_PUSH_ENABLED)</string>
    <key>SleepAPIBaseURL</key><string>$(SLEEP_API_BASE_URL)</string>
    <key>SleepGatewayShareCode</key><string>$(SLEEP_GATEWAY_SHARE_CODE)</string>
    <key>SleepEmailRecoveryEnabled</key><string>$(SLEEP_EMAIL_RECOVERY_ENABLED)</string>
    <key>SleepAPNSEnvironment</key><string>$(SLEEP_APNS_ENVIRONMENT)</string>
    <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>com.rocgrey.sleeptongshu</string><key>CFBundleURLSchemes</key><array><string>sleeptongshu</string></array></dict></array>
    <key>UIBackgroundModes</key><array><string>audio</string></array>
    <key>SleepHealthKitEnabled</key><string>$(SLEEP_HEALTHKIT_ENABLED)</string>
    <key>NSMicrophoneUsageDescription</key><string>主动开启手机监测后在本机分析声音与疑似鼾声；另行同意后保存候选语音片段，仅保存在本机，可回听、删除和主动导出。</string>
    <key>NSMotionUsageDescription</key><string>手机监测使用加速度传感器观察床面体动，辅助估算安静时段。</string>
    <key>NSHealthShareUsageDescription</key><string>读取你允许的睡眠时间与阶段，在本机展示睡眠图表和来源；启用自动同步后，睡眠及步数同步到当前登录账号，不写回系统健康。健康概览还可读取你允许的心率、HRV、血氧、呼吸、步数、距离、能量、身体测量、体能训练、血压、最大摄氧量及年龄参考资料。你可选择允许读取的项目，在个人页关闭自动同步。</string>
</dict></plist>
